{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worki",
  "version": "0.2.4",
  "identifier": "io.fibe.worki",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "worki",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQkZGQUE5MkNEOUMwOUMKUldTY3dOa3NxZnEvNEI1N3VaTHE0KzBhNFgxQUxESjBoTTcxQ3EzNlUwamxPNHZRN1Qvc3lELzcK",
      "endpoints": ["https://github.com/silvanfischer/worki/releases/latest/download/latest.json"]
    }
  }
}
